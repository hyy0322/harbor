# git apply 3370.patch

# # add patch redis
# git apply ${SCRIPT_PATH}/redis.patch

# # for new golang version, go module should be closed
export GOPATH=${SCRIPT_PATH}
go env -w GO111MODULE=off

echo 'build the registry binary ...'
CGO_ENABLED=0 make PREFIX=/go clean binaries

