+func getInstanceFromRepo(repo distribution.Repository) string {
+	fullName := repo.Named().Name()
+	parts := strings.Split(fullName, "/")
+	projName := parts[0]
+	parts = strings.Split(projName, "__")
+	if len(parts) >= 2 {
+		return parts[0]
+	}
+
+	return ""
+}
